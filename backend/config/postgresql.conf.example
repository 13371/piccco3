# PostgreSQL 性能优化配置示例
# 适用于 2GB 内存环境
# 使用方法：复制到 /etc/postgresql/*/main/postgresql.conf 并重启 PostgreSQL

# ============================================
# 内存配置（重点）
# ============================================

# 共享缓冲区（推荐为系统内存的 25%，2GB 环境使用 512MB）
shared_buffers = 512MB

# 工作内存（每个查询操作的内存，2GB 环境使用 8MB）
work_mem = 8MB

# 维护工作内存（VACUUM、CREATE INDEX 等操作的内存，2GB 环境使用 128MB）
maintenance_work_mem = 128MB

# 有效缓存大小（操作系统和 PostgreSQL 共享缓冲区，2GB 环境使用 1GB）
effective_cache_size = 1GB

# ============================================
# WAL（Write-Ahead Log）配置
# ============================================

# WAL 级别（replica 支持流复制和归档）
wal_level = replica

# 检查点超时（15分钟）
checkpoint_timeout = 15min

# 最大 WAL 大小（1GB）
max_wal_size = 1GB

# WAL 压缩（减少 IO 压力）
wal_compression = on

# ============================================
# 连接配置
# ============================================

# 最大连接数（通过 PgBouncer 控制，这里设置较大值）
max_connections = 200

# ============================================
# 查询优化
# ============================================

# 启用查询计划缓存
plan_cache_mode = auto

# 随机页面成本（SSD 优化）
random_page_cost = 1.1

# 有效 IO 并发数（SSD 优化）
effective_io_concurrency = 200

# ============================================
# 日志配置（可选）
# ============================================

# 启用慢查询日志（超过 1 秒的查询）
log_min_duration_statement = 1000

# 记录所有查询（仅用于调试，生产环境建议关闭）
# log_statement = 'all'

# ============================================
# 其他优化
# ============================================

# 自动清理（定期清理过期数据）
autovacuum = on

# 自动分析（定期更新统计信息）
autovacuum_analyze_scale_factor = 0.05





